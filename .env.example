# Postgres connection string — from Neon (neon.tech), free tier is plenty for this.
DATABASE_URL=

# Vercel Blob token — used to store intake photos.
# From: Vercel dashboard > Storage > Blob > create store > copy token
BLOB_READ_WRITE_TOKEN=

# Resend — email delivery. From: resend.com dashboard > API Keys.
RESEND_API_KEY=
# Must be a verified sending address/domain in Resend. Use onboarding@resend.dev for quick testing.
RESEND_FROM_EMAIL=

# Set to "true" once the A2P 10DLC brand/campaign is approved — until then,
# SMS is skipped (email notifications still send) since carriers reject
# unregistered traffic.
SMS_ENABLED=false

# Twilio — SMS delivery. Account SID is always required (twilio.com console home page).
TWILIO_ACCOUNT_SID=
# Then EITHER the main Auth Token (same console page)...
TWILIO_AUTH_TOKEN=
# ...OR a scoped API Key instead (console.twilio.com/us1/account/keys-credentials/api-keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The Twilio phone number messages are sent from, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Where owner notifications (new request email + SMS) are sent.
OWNER_EMAIL=
OWNER_PHONE=

# Admin login — generate with: node scripts/hash-password.mjs "your-password"
# (output is base64-encoded on purpose — a raw bcrypt hash's `$` characters
# get silently corrupted by Next.js's env variable interpolation otherwise)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=

# Used to build the "review this request" link in owner notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq — Qwen 3.6 27B vision for screenshot OCR (console.groq.com).
# Without this, intake still stores images/text but won't extract CRM fields.
GROQ_API_KEY=

# Resend inbound (email screenshots to the shop). Webhook signing secret
# from Resend → Webhooks → the email.received endpoint.
RESEND_WEBHOOK_SECRET=
# Optional comma-separated allowlist. OWNER_EMAIL is always included.
# Use * to accept any sender (dev only).
INTAKE_ALLOWED_SENDERS=

# Telegram bot intake (screenshots of customer threads). Token from BotFather.
TELEGRAM_BOT_TOKEN=
# Random string passed to setWebhook secret_token; Telegram sends it back
# as X-Telegram-Bot-Api-Secret-Token. Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated Telegram user ids. Empty = accept anyone who
# can reach the bot (lock this down after /start tells you your id).
TELEGRAM_ALLOWED_USER_IDS=

# Shopify — replaces Stripe + direct-Printify-API for the merch store and
# repair-invoice payments (see docs/shopify-migration-plan.md). Printify's
# official Shopify app manages the Printify relationship inside Shopify's
# own admin now — no PRINTIFY_* credentials needed here anymore.

# From: Shopify admin > Sales channels > install the "Headless" channel >
# Create storefront. Public token goes client-side; the private one is the
# one to actually use server-side and must never be exposed to the browser.
# This private token now comes back shpat_-prefixed, same as an Admin API
# token — don't use that prefix to tell them apart. What actually matters:
# send it as the `Shopify-Storefront-Private-Token` header, NOT the older
# `X-Shopify-Storefront-Access-Token` header most docs/tutorials still show
# (that one 401s a shpat_-style private token outright).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Backend-only — used for repair-invoice Draft Orders (draftOrderCreate /
# draftOrderInvoiceSend) AND auto-publishing Printify-synced products to the
# Headless channel (publishablePublish — see
# app/api/shopify/webhooks/products-create/route.ts). New custom-app
# creation now requires the Shopify CLI or Dev Dashboard, not the old
# "Settings > Apps > Develop apps" flow — see docs/shopify-migration-plan.md
# for the current setup steps. Scopes: write_draft_orders, read_orders,
# read_products, write_publications. Adding a scope to an already-installed
# app needs re-approval — Dev Dashboard > app > Versions > add scope >
# Release, then Shopify admin > Settings > Apps > open this app to approve
# the new permissions (no reinstall needed).
#
# Apps created this way have no permanent access token to paste in — Client
# ID/secret (Dev Dashboard > your app > Settings) are exchanged at RUNTIME
# for a ~24h Admin API access token via the client credentials grant:
#   POST https://{shop}.myshopify.com/admin/oauth/access_token
#   body: client_id, client_secret, grant_type=client_credentials
# Our code re-fetches when the token is close to expiring; nothing here
# holds the actual bearer token.
SHOPIFY_DEV_APP_CLIENT_ID=
SHOPIFY_DEV_APP_CLIENT_SECRET=
# Same value as the client secret above — Shopify signs the incoming
# orders/paid webhook with the app's client secret, not with the short-lived
# access token. Kept as its own var purely so call sites read clearly.
SHOPIFY_WEBHOOK_SECRET=

# The Headless channel's Publication id (a one-time lookup, not a secret —
# but store-specific). From: node scripts/find-headless-publication-id.mjs
SHOPIFY_HEADLESS_PUBLICATION_ID=
