# Postgres connection string — from Neon (neon.tech), free tier is plenty for this.
DATABASE_URL=

# Vercel Blob token — used to store intake photos.
# From: Vercel dashboard > Storage > Blob > create store > copy token
BLOB_READ_WRITE_TOKEN=

# Resend — email delivery. From: resend.com dashboard > API Keys.
RESEND_API_KEY=
# Must be a verified sending address/domain in Resend. Use onboarding@resend.dev for quick testing.
RESEND_FROM_EMAIL=

# Set to "true" once the A2P 10DLC brand/campaign is approved — until then,
# SMS is skipped (email notifications still send) since carriers reject
# unregistered traffic.
SMS_ENABLED=false

# Twilio — SMS delivery. Account SID is always required (twilio.com console home page).
TWILIO_ACCOUNT_SID=
# Then EITHER the main Auth Token (same console page)...
TWILIO_AUTH_TOKEN=
# ...OR a scoped API Key instead (console.twilio.com/us1/account/keys-credentials/api-keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The Twilio phone number messages are sent from, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Where owner notifications (new request email + SMS) are sent.
OWNER_EMAIL=
OWNER_PHONE=

# Admin login — generate with: node scripts/hash-password.mjs "your-password"
# (output is base64-encoded on purpose — a raw bcrypt hash's `$` characters
# get silently corrupted by Next.js's env variable interpolation otherwise)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=

# Used to build the "review this request" link in owner notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — store payments (online Payment Element + in-person Terminal).
# From: dashboard.stripe.com > Developers > API keys. Use test-mode (sk_test_/
# pk_test_) keys until the whole flow is verified end to end.
STRIPE_SECRET_KEY=
# From: dashboard.stripe.com > Developers > Webhooks > add endpoint,
# pointed at /api/store/webhooks/stripe, subscribed to payment_intent.succeeded.
STRIPE_WEBHOOK_SECRET=
# Safe to expose client-side — it's not the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# A Stripe Terminal Location id (dashboard.stripe.com > Terminal > Locations),
# required even for the simulated reader used during development.
STRIPE_TERMINAL_LOCATION_ID=

# Printify — merch fulfillment. No sandbox/test mode: this is always the
# real API token against the real connected shop.
# Setup: My Stores > Add new store > type "API" > My Profile > Connections >
# generate a personal access token > GET /v1/shops.json for the shop id.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Generate with: openssl rand -hex 20 — used when registering the webhook
# (scripts/register-printify-webhook.mjs), pointed at /api/store/webhooks/printify.
PRINTIFY_WEBHOOK_SECRET=
