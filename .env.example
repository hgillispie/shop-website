# Postgres connection string — from Neon (neon.tech), free tier is plenty for this.
DATABASE_URL=

# Vercel Blob token — used to store intake photos.
# From: Vercel dashboard > Storage > Blob > create store > copy token
BLOB_READ_WRITE_TOKEN=

# Resend — email delivery. From: resend.com dashboard > API Keys.
RESEND_API_KEY=
# Must be a verified sending address/domain in Resend. Use onboarding@resend.dev for quick testing.
RESEND_FROM_EMAIL=

# Set to "true" once the A2P 10DLC brand/campaign is approved — until then,
# SMS is skipped (email notifications still send) since carriers reject
# unregistered traffic.
SMS_ENABLED=false

# Twilio — SMS delivery. Account SID is always required (twilio.com console home page).
TWILIO_ACCOUNT_SID=
# Then EITHER the main Auth Token (same console page)...
TWILIO_AUTH_TOKEN=
# ...OR a scoped API Key instead (console.twilio.com/us1/account/keys-credentials/api-keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The Twilio phone number messages are sent from, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Where owner notifications (new request email + SMS) are sent.
OWNER_EMAIL=
OWNER_PHONE=

# Admin login — generate with: node scripts/hash-password.mjs "your-password"
# (output is base64-encoded on purpose — a raw bcrypt hash's `$` characters
# get silently corrupted by Next.js's env variable interpolation otherwise)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=

# Used to build the "review this request" link in owner notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify — replaces Stripe + direct-Printify-API for the merch store and
# repair-invoice payments (see docs/shopify-migration-plan.md). Printify's
# official Shopify app manages the Printify relationship inside Shopify's
# own admin now — no PRINTIFY_* credentials needed here anymore.

# From: Shopify admin > Sales channels > install the "Headless" channel >
# Create storefront. Public token goes client-side; the private one is the
# one to actually use server-side and must never be exposed to the browser.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Backend-only — used for repair-invoice Draft Orders (draftOrderCreate /
# draftOrderInvoiceSend). New custom-app creation now requires the Shopify
# CLI or Dev Dashboard, not the old "Settings > Apps > Develop apps" flow —
# see docs/shopify-migration-plan.md for the current setup steps. Scope to
# just write_draft_orders + read_orders.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# The app's API secret key (client secret) — used as the HMAC signing key
# to verify the incoming orders/paid webhook, not the access token itself.
SHOPIFY_WEBHOOK_SECRET=
